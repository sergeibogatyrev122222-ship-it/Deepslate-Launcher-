# Normalise to LF in the repository. Without this, Windows checkouts commit CRLF
# and the shell scripts become unrunnable on Linux and macOS.
* text=auto eol=lf

# These are Windows-only and want CRLF on disk.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binaries.
*.ico binary
*.png binary
*.jar binary
