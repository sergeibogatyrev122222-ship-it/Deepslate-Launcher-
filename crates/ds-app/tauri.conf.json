{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepslate",
  "version": "0.1.0",
  "identifier": "dev.deepslate.launcher",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Deepslate",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
